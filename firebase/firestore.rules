rules_version = '2';

// =============================================================================
// NN APP — Cloud Firestore Security Rules
//
// Posture: DEFAULT DENY. Nothing is reachable unless a rule below explicitly
// allows it. Because every record the founder owns lives under
// users/{uid}/..., a single ownership check protects every application in NN
// — including applications that have not been written yet.
//
// These rules are the real authorisation boundary. The interface never is.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // App Check attests that a request came from the genuine NN client. It is
    // NOT authentication and NOT authorisation — it only filters out unknown
    // clients. Enforcement stays off until real traffic has been observed, per
    // the specification. To enforce: return request.app != null;
    function appCheckOk() {
      return true;
    }

    function owner(uid) {
      return isOwner(uid) && appCheckOk();
    }

    // Collections only a trusted server may write. The Admin SDK bypasses
    // rules entirely, so denying every client write here is what makes them
    // server-authored. This is how ORIN is prevented from widening its own
    // permissions or editing its own audit trail.
    function serverWritten(c) {
      return c in [
        'audit_logs',       // the record of what happened — must be tamper-proof
        'security_events',  // sign-ins, revocations, failures
        'permissions',      // what ORIN and integrations may do
        'summaries',        // dashboard aggregates, computed server-side
        'backups',          // backup manifests and verification state
        'tool_executions',  // every action ORIN has taken
        'credentials',      // passkey public keys and signature counters
        'system_health',
        'job_runs'
      ];
    }

    // --------------------------------------------------------------- validity

    function isTimestamp(v) {
      return v is timestamp;
    }

    // Every document must carry its own provenance. Without this a record
    // cannot be audited, migrated or restored with confidence.
    function hasMeta(d) {
      return d.keys().hasAll(['createdAt', 'updatedAt', 'schemaVersion'])
        && isTimestamp(d.createdAt)
        && isTimestamp(d.updatedAt)
        && d.schemaVersion is int
        && d.schemaVersion >= 1;
    }

    // Guards against a single oversized document, which fails writes silently
    // once it passes 1 MiB. Large content belongs in Cloud Storage.
    function reasonableSize(d) {
      return d.size() <= 120;
    }

    function createdAtPreserved() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }

    // updatedAt must actually move forward, so "last changed" can be trusted.
    function updatedAtAdvances() {
      return request.resource.data.updatedAt >= resource.data.updatedAt;
    }

    function validCreate() {
      return hasMeta(request.resource.data)
        && reasonableSize(request.resource.data);
    }

    function validUpdate() {
      return hasMeta(request.resource.data)
        && reasonableSize(request.resource.data)
        && createdAtPreserved()
        && updatedAtAdvances();
    }

    // Credentials must never reach Firestore. OAuth tokens and API keys live
    // in Secret Manager and are referenced by id; a document the client can
    // read is the wrong place for anything that grants access. Enforcing it
    // here means a bug in any of the 34 applications cannot leak one.
    function noCredentialFields(d) {
      return !d.keys().hasAny([
        'accessToken', 'refreshToken', 'idToken', 'apiKey', 'apiSecret',
        'clientSecret', 'privateKey', 'password', 'secret', 'sessionToken'
      ]);
    }

    // Privilege-bearing fields are decided by the server, never asserted by
    // the client. Without this, a writable document such as an app's install
    // record could be used to grant that app — or ORIN — new scopes.
    function noPrivilegeFields(d) {
      return !d.keys().hasAny([
        'permissions', 'grantedScopes', 'scopes', 'role', 'roles',
        'isAdmin', 'admin', 'tier', 'approvedBy'
      ]);
    }

    // Ownership is structural — it comes from the document's path. A document
    // that also carries an owner field could be used to claim someone else's.
    function noForgedOwner(uid, d) {
      return !d.keys().hasAny(['ownerUid', 'uid', 'userId'])
        || (d.get('ownerUid', uid) == uid
            && d.get('uid', uid) == uid
            && d.get('userId', uid) == uid);
    }

    function safeClientWrite(uid, d) {
      return noCredentialFields(d) && noPrivilegeFields(d) && noForgedOwner(uid, d);
    }

    // A memory the founder stated himself is evidence. A memory ORIN inferred
    // is a guess. The two must never be confused, so the client may only ever
    // write 'stated' — anything else has to come from a trusted server.
    function memorySourceHonest(c, d) {
      return c != 'memories' || !('source' in d.keys()) || d.source == 'stated';
    }

    // ------------------------------------------------------- the owner record

    match /users/{uid} {
      allow get, list: if owner(uid);
      allow create: if owner(uid) && validCreate() && safeClientWrite(uid, request.resource.data);
      allow update: if owner(uid) && validUpdate() && safeClientWrite(uid, request.resource.data);
      // Deleting the owner record would orphan every subcollection in NN.
      // Account deletion is a deliberate server-side workflow, never a write.
      allow delete: if false;
    }

    // ------------------------------------------- every application collection

    match /users/{uid}/{collection}/{docId} {
      allow get, list: if owner(uid);

      allow create: if owner(uid)
        && !serverWritten(collection)
        && validCreate()
        && safeClientWrite(uid, request.resource.data)
        && memorySourceHonest(collection, request.resource.data);

      allow update: if owner(uid)
        && !serverWritten(collection)
        && validUpdate()
        && safeClientWrite(uid, request.resource.data)
        && memorySourceHonest(collection, request.resource.data);

      allow delete: if owner(uid) && !serverWritten(collection);
    }

    // The founder must always be able to remove a passkey from a lost device,
    // even though he can never create or alter one.
    match /users/{uid}/credentials/{credentialId} {
      allow delete: if owner(uid);
    }

    // ------------------------------------------------------- subcollections

    match /users/{uid}/{collection}/{docId}/{sub}/{subId} {
      allow get, list: if owner(uid);

      allow create: if owner(uid)
        && !serverWritten(collection)
        && validCreate()
        && safeClientWrite(uid, request.resource.data);

      // Version history and dated log entries are append-only by design: the
      // founder's original note must survive every later edit.
      allow update, delete: if owner(uid)
        && !serverWritten(collection)
        && !(sub in ['versions', 'occurrences', 'entries', 'messages', 'steps']);
    }

    // ------------------------------------------------- shared reference data

    // Verified libraries — formulas, curricula. Readable by the signed-in
    // owner, writable only by a trusted server after review.
    match /reference/{document=**} {
      allow read: if signedIn() && appCheckOk();
      allow write: if false;
    }

    // ------------------------------------------------------------ catch-all

    // Anything not matched above is denied. New collections are protected the
    // moment they exist, before anyone remembers to write a rule for them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
