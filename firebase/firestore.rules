rules_version = '2';

// NN APP — Firestore Security Rules
// PHASE 2 PLACEHOLDER: default-deny. Real owner-scoped rules are written in Phase 2
// together with their emulator tests. Until then nothing can read or write anything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
