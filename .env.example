# ─────────────────────────────────────────────────────────────────────────────
# NN APP — environment template
#
# Copy to apps/web/.env.local and fill in. NEVER commit a real .env.local.
# Every name below is read by actual code; nothing here is aspirational.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase web config — READ BY: packages/firebase/src/config.ts ───────────
# Safe in the browser by design. A Firebase web API key identifies the project;
# it grants nothing. Access is decided entirely by Authentication and Security
# Rules. Get these from the Firebase Console:
#   Project settings → General → Your apps → Web app → SDK setup → Config
# Or, faster:  firebase apps:sdkconfig WEB --project nn-os-dev
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nn-os-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Local development ────────────────────────────────────────────────────────
# "true" points Auth (9099), Firestore (8080) and Storage (9199) at the local
# emulators. Any other value, including "false", uses the real project.
# Keep this true for local work: nothing then touches real data, and Cloud
# Storage is unavailable on the Spark plan anyway.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# ── App Check — OPTIONAL. READ BY: apps/web/src/lib/firebase/client.ts ───────
# Leave BLANK for local development; App Check is then skipped entirely and
# cannot block anything. App Check is not authentication and not
# authorisation — it only attests that a request came from the genuine client.
# Site key: Firebase Console → App Check → Apps → Web → reCAPTCHA Enterprise.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Debug token for a developer machine once App Check is enforced. Blank
# otherwise. Console → App Check → Apps → ⋮ → Manage debug tokens.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# ── WebAuthn / passkeys — READ BY: packages/auth/src/webauthn.ts ─────────────
# RP_ID is a bare registrable domain: no scheme, no port. ORIGIN is the exact
# origin the browser reports and may be a comma-separated list. They must
# agree or passkeys fail silently in the browser — validated at startup.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=NN
WEBAUTHN_ORIGIN=http://localhost:3000

# ── First-owner bootstrap — READ BY: api/auth/register/options ───────────────
# Required ONCE, to claim an unowned NN. Minimum 24 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The moment NN has an owner this stops working permanently, so a later leak
# is not a back door. Never commit a real value.
NN_BOOTSTRAP_SECRET=

# ── Firebase Admin — READ BY: apps/web/src/server/admin.ts ───────────────────
# NOT needed while NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true. Required only
# against a real project. Paste the whole service-account JSON on one line.
# Console → Project settings → Service accounts → Generate new private key.
# This IS a real secret. Never commit it.
FIREBASE_SERVICE_ACCOUNT=

# ─────────────────────────────────────────────────────────────────────────────
# Set automatically — do not add these by hand:
#   FIRESTORE_EMULATOR_HOST, FIREBASE_AUTH_EMULATOR_HOST
#       set by `firebase emulators:exec`
#   GCE_METADATA_HOST
#       set by apps/web/src/server/admin.ts under emulators, to stop the
#       Admin SDK waiting ~13s on a GCP metadata probe that cannot succeed
#   GCLOUD_PROJECT
#       fallback for NEXT_PUBLIC_FIREBASE_PROJECT_ID
#
# NOT YET USED BY ANY CODE — deliberately absent so the template never implies
# a capability that does not exist. They arrive with ORIN in Phase 6:
#   ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_AI_API_KEY,
#   ELEVENLABS_API_KEY, DEEPGRAM_API_KEY
# ─────────────────────────────────────────────────────────────────────────────
