# ─────────────────────────────────────────────────────────────
# NN APP — environment template
# Copy to .env.local and fill in. NEVER commit a real .env file.
# ─────────────────────────────────────────────────────────────

# ---- Firebase web client (safe to expose to the browser) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase App Check (reCAPTCHA Enterprise site key) ----
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Debug token for local development only. Never set in production.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# ---- Emulators (local development) ----
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ---- WebAuthn / passkeys (server side) ----
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=NN
WEBAUTHN_ORIGIN=http://localhost:3000

# ---- ORIN AI providers (SERVER ONLY — never NEXT_PUBLIC_) ----
# Leave blank to run NN without AI. Status will read NEEDS CONFIGURATION.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ---- Speech (optional) ----
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# ---- Defaults ----
NN_DEFAULT_TIMEZONE=Asia/Kolkata
NN_ASSISTANT_DEFAULT_NAME=ORIN
